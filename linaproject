
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PPDB Online - Sekolah Hebat</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="logo">🎓 PPDB ONLINE</div>
        <ul>
            <li><a href="#home">Beranda</a></li>
            <li><a href="#informasi">Informasi</a></li>
            <li><a href="#daftar">Pendaftaran</a></li>
        </ul>
    </nav>

    <!-- HERO -->
    <section class="hero" id="home">
        <div class="hero-content">
            <span class="tag">TAHUN AJARAN 2027/2028</span>
            <h1>Masa Depan Cerah Dimulai Dari Sini!</h1>
            <p>
                Bergabunglah bersama kami untuk meraih prestasi,
                mengembangkan bakat, dan membangun masa depan.
            </p>
            <a href="#daftar" class="btn">Daftar Sekarang →</a>
        </div>
    </section>

    <!-- INFORMASI -->
    <section class="informasi" id="informasi">
        <h2>Informasi Pendaftaran</h2>
        <p class="subtitle">Persiapkan dirimu menjadi bagian dari sekolah kami.</p>

        <div class="info-container">
            <div class="info-box">
                <div class="icon">📅</div>
                <h3>Jadwal Pendaftaran</h3>
                <p>1 Januari - 30 Juni 2027</p>
            </div>

            <div class="info-box">
                <div class="icon">📄</div>
                <h3>Persyaratan</h3>
                <p>Ijazah, KK, Akta Kelahiran, dan Pas Foto.</p>
            </div>

            <div class="info-box">
                <div class="icon">🏫</div>
                <h3>Pilihan Jurusan</h3>
                <p>RPL, TKJ, DKV, dan Akuntansi.</p>
            </div>
        </div>
    </section>

    <!-- FORM PENDAFTARAN -->
    <section class="daftar" id="daftar">
        <div class="form-container">

            <div class="form-header">
                <h2>Formulir Pendaftaran</h2>
                <p>Silakan lengkapi data diri calon siswa dengan benar.</p>
            </div>

            <form id="formPPDB">

                <h3>01. Data Pribadi</h3>

                <label>Nama Lengkap</label>
                <input type="text" placeholder="Masukkan nama lengkap"
                    name="nama" required>

                <div class="form-row">
                    <div>
                        <label>NISN</label>
                        <input type="text" placeholder="Nomor NISN"
                            name="nisn" required>
                    </div>

                    <div>
                        <label>NIK</label>
                        <input type="text" placeholder="Nomor NIK"
                            name="nik" required>
                    </div>
                </div>

                <div class="form-row">
                    <div>
                        <label>Tempat Lahir</label>
                        <input type="text" placeholder="Tempat lahir"
                            name="tempat" required>
                    </div>

                    <div>
                        <label>Tanggal Lahir</label>
                        <input type="date" name="tanggal" required>
                    </div>
                </div>

                <label>Jenis Kelamin</label>
                <select name="gender" required>
                    <option value="">Pilih jenis kelamin</option>
                    <option>Laki-laki</option>
                    <option>Perempuan</option>
                </select>

                <label>Alamat Lengkap</label>
                <textarea name="alamat" rows="3"
                    placeholder="Masukkan alamat lengkap"
                    required></textarea>

                <label>Upload Foto Siswa</label>
                <input type="file" name="foto"
                    accept="image/*" required>

                <h3>02. Data Pendidikan</h3>

                <label>Asal Sekolah</label>
                <input type="text" name="sekolah"
                    placeholder="Nama sekolah sebelumnya" required>

                <label>Pilih Jurusan</label>
                <select name="jurusan" required>
                    <option value="">Pilih jurusan</option>
                    <option>Rekayasa Perangkat Lunak (RPL)</option>
                    <option>Teknik Komputer dan Jaringan (TKJ)</option>
                    <option>Desain Komunikasi Visual (DKV)</option>
                    <option>Akuntansi</option>
                </select>

                <h3>03. Data Orang Tua</h3>

                <label>Nama Ayah</label>
                <input type="text" name="ayah"
                    placeholder="Nama ayah" required>

                <label>Nama Ibu</label>
                <input type="text" name="ibu"
                    placeholder="Nama ibu" required>

                <label>Nomor HP Orang Tua</label>
                <input type="tel" name="telepon"
                    placeholder="08xxxxxxxxxx" required>

                <div class="agreement">
                    <input type="checkbox" id="setuju" required>
                    <label for="setuju">
                        Saya menyatakan bahwa data yang diisi benar.
                    </label>
                </div>

                <div class="button-group">
                    <button type="reset" class="reset">Reset</button>
                    <button type="submit" class="submit">
                        Kirim Pendaftaran →
                    </button>
                </div>

            </form>

            <div id="hasil" class="hasil"></div>

        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <h3>🎓 PPDB ONLINE</h3>
        <p>Website Penerimaan Peserta Didik Baru</p>
        <p>© 2027 Sekolah Hebat. All Rights Reserved.</p>
    </footer>

    <script>
        document.getElementById("formPPDB")
        .addEventListener("submit", function(event) {
            event.preventDefault();

            const nama = this.elements["nama"].value;

            document.getElementById("hasil").innerHTML =
                "🎉 Selamat! Pendaftaran atas nama <b>" +
                nama.replace(/[&<>"']/g, function(char) {
                    return {
                        "&": "&amp;",
                        "<": "&lt;",
                        ">": "&gt;",
                        '"': "&quot;",
                        "'": "&#39;"
                    }[char];
                }) +
                "</b> berhasil dikirim pada formulir demo.";

            this.reset();
        });
    </script>

</body>
</html>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', sans-serif;
    scroll-behavior: smooth;
}

body {
    background: #f5f7fb;
    color: #263449;
}

/* NAVBAR */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background: white;
    box-shadow: 0 3px 15px #0000000d;
}

.logo {
    font-size: 22px;
    font-weight: bold;
    color: #2563eb;
}

.navbar ul {
    display: flex;
    list-style: none;
    gap: 30px;
}

.navbar a {
    text-decoration: none;
    color: #334155;
    font-weight: 600;
}

.navbar a:hover {
    color: #2563eb;
}

/* HERO */
.hero {
    min-height: 450px;
    display: flex;
    align-items: center;
    padding: 70px 10%;
    background:
    linear-gradient(100deg, #172554ed, #2563ebbb),
    url("https://images.unsplash.com/photo-1523050854058-8df90110c9f1?w=1600")
    center/cover;
    color: white;
}

.hero-content {
    max-width: 650px;
}

.tag {
    background: #ffffff25;
    padding: 10px 18px;
    border-radius: 30px;
    font-size: 12px;
    letter-spacing: 1px;
}

.hero h1 {
    font-size: 45px;
    margin: 25px 0 15px;
    line-height: 1.2;
}

.hero p {
    line-height: 1.8;
    margin-bottom: 30px;
}

.btn {
    display: inline-block;
    padding: 14px 25px;
    background: white;
    color: #2563eb;
    text-decoration: none;
    border-radius: 10px;
    font-weight: bold;
    transition: 0.3s;
}

.btn:hover {
    background: #dbeafe;
    transform: translateY(-3px);
}

/* INFORMASI */
.informasi {
    padding: 70px 8%;
    text-align: center;
}

.informasi h2 {
    font-size: 30px;
    color: #1e3a8a;
}

.subtitle {
    color: #64748b;
    margin-top: 10px;
}

.info-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 35px;
}

.info-box {
    background: white;
    padding: 30px 20px;
    border-radius: 15px;
    box-shadow: 0 5px 20px #00000009;
    transition: 0.3s;
}

.info-box:hover {
    transform: translateY(-7px);
}

.icon {
    font-size: 35px;
    margin-bottom: 15px;
}

.info-box h3 {
    margin-bottom: 12px;
    color: #2563eb;
}

.info-box p {
    color: #64748b;
    line-height: 1.6;
}

/* FORM */
.daftar {
    padding: 60px 15px;
    background: #eaf0ff;
}

.form-container {
    background: white;
    max-width: 750px;
    margin: auto;
    padding: 40px;
    border-radius: 20px;
    box-shadow: 0 10px 35px #0000000c;
}

.form-header {
    text-align: center;
    margin-bottom: 35px;
}

.form-header h2 {
    color: #1e3a8a;
    font-size: 28px;
}

.form-header p {
    margin-top: 10px;
    color: #64748b;
}

form h3 {
    color: #2563eb;
    margin: 30px 0 18px;
    padding-bottom: 12px;
    border-bottom: 2px solid #dbeafe;
}

form label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    font-size: 14px;
}

form input:not([type="checkbox"]),
form select,
form textarea {
    width: 100%;
    padding: 13px;
    margin-bottom: 20px;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    outline: none;
    font-size: 14px;
    background: white;
}

form input:focus,
form select:focus,
form textarea:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px #2563eb15;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.form-row > div {
    min-width: 0;
}

/* PERSETUJUAN */
.agreement {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 15px 0 25px;
}

.agreement input {
    width: 17px;
    height: 17px;
}

.agreement label {
    margin: 0;
}

/* BUTTON */
.button-group {
    display: flex;
    gap: 15px;
}

.button-group button {
    flex: 1;
    padding: 14px;
    border: none;
    border-radius: 9px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

.reset {
    background: #e2e8f0;
    color: #334155;
}

.submit {
    background: #2563eb;
    color: white;
}

.submit:hover {
    background: #1d4ed8;
    transform: translateY(-2px);
}

.reset:hover {
    background: #cbd5e1;
}

/* HASIL */
.hasil {
    margin-top: 20px;
    padding: 15px;
    background: #dcfce7;
    color: #166534;
    border-radius: 10px;
    text-align: center;
}

/* FOOTER */
footer {
    background: #172554;
    color: white;
    text-align: center;
    padding: 35px 15px;
    line-height: 2;
}

/* RESPONSIVE */
@media (max-width: 700px) {
    .navbar {
        flex-direction: column;
        gap: 18px;
    }

    .navbar ul {
        gap: 15px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero h1 {
        font-size: 32px;
    }

    .info-container {
        grid-template-columns: 1fr;
    }

    .form-container {
        padding: 25px 18px;
    }

    .form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }
}

@media (max-width: 400px) {
    .navbar ul {
        gap: 10px;
        font-size: 13px;
    }

    .button-group {
        flex-direction: column;
    }
}
    